table GST
	lineageTag: a45ca7a4-e163-4cae-9554-8909c0cfd5d8

	measure 'Total GST' = SUM ( GST[total_gst_excl_cess] )
		formatString: #,0
		lineageTag: 57c0005f-1dd4-44fa-b676-4360f7d5660c

	measure 'GST FY25' = CALCULATE ( [Total GST], GST[financial_year] = "2024-25" )
		formatString: #,0
		lineageTag: 0762465b-6407-4c7f-a21a-41ac2c19fb5c

	measure 'GST FY24' = CALCULATE ( [Total GST], GST[financial_year] = "2023-24" )
		formatString: #,0
		lineageTag: fbe20511-7879-46b0-a601-a965fa6799ca

	measure 'YoY Growth %' = DIVIDE ( [GST FY25] - [GST FY24], [GST FY24] )
		formatString: 0.0%
		lineageTag: 3f644624-c126-48a2-b92c-cf45593a49c9

	measure 'Maharashtra Share' =
			DIVIDE (
			    CALCULATE ( [Total GST], GST[state_name] = "Maharashtra" ),
			    CALCULATE ( [Total GST], ALL ( GST ) )
			)
		formatString: 0.0%
		lineageTag: 730d072c-6ae0-40ef-aa4c-4f01fdccd4e4

	measure 'Fastest Growing State' =
			VAR Growth =
			    ADDCOLUMNS (
			        VALUES ( GST[state_name] ),
			        "@g", [YoY Growth %]
			    )
			RETURN
			    MAXX ( TOPN ( 1, Growth, [@g], DESC ), GST[state_name] )
		lineageTag: 4af914c3-28b7-4091-ae3f-6794fa1209f6

